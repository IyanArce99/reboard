# Copia este archivo a `.env.local` y rellena los valores. `.env.local` no se versiona.
# Reglas (docs/SECURITY.md): solo las variables con NEXT_PUBLIC_ llegan al navegador.
# Nunca pongas una clave secreta con el prefijo NEXT_PUBLIC_.

# ───────── En uso hoy ─────────

# Fuente de datos: `mock` (inventario DEMO en memoria). `supabase` aún no está implementado.
REBOARD_DATA_SOURCE=mock

# Tamaño del inventario DEMO: 20 | 100 | 1000 (por defecto, 100).
REBOARD_DEMO_INVENTORY=100

# URL pública para canonical, sitemap y JSON-LD. Producción: https://reboard.es
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── Fases B–G (aún sin uso; ver docs/SECURITY.md §1) ─────────

# Supabase (proyecto en la UE). La URL y la clave anon/publishable son públicas y van bajo RLS.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO SERVIDOR: cron, revelar contacto, moderación y seeds.
# SUPABASE_SERVICE_ROLE_KEY=

# SOLO SERVIDOR: HMAC de la IP en el registro de contactos (cadena aleatoria larga).
# CONTACT_IP_SALT=

# SOLO SERVIDOR: autentica las llamadas de Vercel Cron a /api/cron/*.
# CRON_SECRET=

# Captcha en acciones sensibles (proveedor pendiente de configurar; ver docs/SECURITY.md).
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# Resend se configura como SMTP dentro de Supabase Auth; la app no necesita su clave por ahora.
