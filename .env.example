# Copia este archivo a `.env.local` y rellena los valores. `.env.local` no se versiona.
# Reglas (docs/SECURITY.md): solo las variables con NEXT_PUBLIC_ llegan al navegador.
# Nunca pongas una clave secreta con el prefijo NEXT_PUBLIC_.

# ───────── En uso hoy ─────────

# Fuente de datos: Supabase si están NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY (abajo).
# Sin ellas, la web funciona con la interfaz vacía y en noindex: la app no trae datos simulados.
# Para Supabase local: `npm run db:start` y `npm run env:local` generan `.env.local`.

# Indexación en buscadores: solo con `true` (y con Supabase). Activarla con el dominio definitivo
# y los textos legales revisados (docs/PRODUCTION_SETUP.md).
SITE_INDEXABLE=false

# URL pública para canonical, sitemap y JSON-LD. Producción: https://reboard.es
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── Base de datos real (docs/SECURITY.md §1 y LAUNCH_CHECKLIST.md) ─────────

# Supabase: proyecto único `reboard` (UE). Para Supabase local, `npx supabase status` muestra los valores.
# La URL y la clave anon/publishable son públicas y van bajo RLS. Los Preview de Vercel NO llevan estas claves.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO SERVIDOR: cron, revelar contacto, moderación y borrar cuentas.
# SUPABASE_SERVICE_ROLE_KEY=

# SOLO SERVIDOR: HMAC de la IP en el registro de contactos (≥ 32 caracteres aleatorios). Sin ella no se revela ningún contacto.
# CONTACT_IP_SALT=

# SOLO SERVIDOR: autentica las llamadas de Vercel Cron a /api/cron/expirar (≥ 32 caracteres aleatorios).
# CRON_SECRET=

# Cloudflare Turnstile (gratuito) en acciones sensibles (docs/SECURITY.md §2).
# En desarrollo, las claves de prueba públicas de Turnstile (las pone `npm run env:local`).
# Sin TURNSTILE_SECRET_KEY no se puede publicar, revelar contactos ni reportar (falla cerrado).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Acceso con Google y/o Apple (docs/PRODUCTION_SETUP.md §3b). Solo los proveedores ya activados en
# Supabase → Authentication → Providers; si no, el botón llevaría a un error. Ejemplo: google,apple
# NEXT_PUBLIC_AUTH_PROVIDERS=
# SOLO SERVIDOR:
# TURNSTILE_SECRET_KEY=

# Resend se configura como SMTP dentro de Supabase Auth (docs/SECURITY.md §2): la app no necesita su clave.

# ——— Formulario de contacto: aviso por email (src/lib/email/notify.ts) ———
# SOLO SERVIDOR. Sin SMTP_HOST el mensaje se guarda igual (se ve en /admin/mensajes), pero no llega aviso.
# En producción, el correo de Reboard en DonDominio (465 = SSL). En local, Mailpit: SMTP_HOST=127.0.0.1,
# SMTP_PORT=54325, sin usuario ni contraseña (los correos se ven en http://127.0.0.1:54324).
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hola@reboard.es
# CONTACT_NOTIFY_TO=hola@reboard.es

# ——— Analítica de producto (docs/ANALYTICS.md) ———
# PostHog EU sin cookies. Sin esta clave no se carga nada (ni posthog-js ni el proxy /rb-e).
# Es la «Project API key» (pública: va en el navegador). Solo en Production en Vercel.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Solo local/tests: los eventos no salen; se guardan en window.__rbAnalytics y en la consola.
# NEXT_PUBLIC_ANALYTICS_DEBUG=1
# Límite de peticiones de las API públicas fuera de Vercel (en Vercel está siempre activo).
# RATE_LIMIT=on
