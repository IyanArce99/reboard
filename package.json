{
  "name": "reboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test --project=e2e --project=journeys",
    "test:visual": "playwright test --project=visual --workers=1",
    "db:start": "supabase start -x realtime,edge-runtime,logflare,vector,studio,imgproxy,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "perf:local": "vitest run --config vitest.perf.config.ts",
    "env:local": "node scripts/env-local.mjs",
    "db:seed-demo": "tsx scripts/seed-local-demo.mts",
    "db:seed-photos": "tsx scripts/seed-local-photos.mts",
    "admin:grant": "node --env-file-if-exists=.env.local scripts/grant-admin.mjs",
    "test:e2e:admin": "playwright test -c playwright.admin.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "nodemailer": "10.2.1",
    "posthog-js": "1.438.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
